+int mt7615_mcu_set_csi(struct mt7615_dev *dev, bool enable)
+{
+	struct mt7615_mcu_csi req = {
+		.enable = enable ? 1 : 0,
+	};
+	int ret;
+
+	dev_info(dev->mt76.dev, "Dispatching MCU_EXT_CMD_CSI_CTRL (0xc2): enable=%d\n", req.enable);
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(CSI_CTRL),
+				&req, sizeof(req), false);
+	if (ret)
+		dev_warn(dev->mt76.dev, "MCU_EXT_CMD_CSI_CTRL dispatch failed: %d\n", ret);
+	return ret;
+}
+
+void mt7615_mcu_rx_csi(struct mt7615_dev *dev, struct sk_buff *skb)
+{
+	static DEFINE_RATELIMIT_STATE(csi_rs, HZ, 5);
+	struct mt7615_mcu_rxd *rxd;
+	struct mt76_csi_buf *csi_buf = dev->mt76.csi_buf;
+	struct mt76_csi_data *csi_rec;
+	unsigned long flags;
+	u8 *payload;
+	size_t payload_len;
+	int ant, sc;
+
+	if (!csi_buf || !csi_buf->capture_active)
+		return;
+
+	if (skb->len < sizeof(*rxd))
+		return;
+
+	rxd = (struct mt7615_mcu_rxd *)skb->data;
+	payload = skb->data + sizeof(*rxd);
+	payload_len = skb->len - sizeof(*rxd);
+
+	if (payload_len < 4)
+		return;
+
+	if (__ratelimit(&csi_rs)) {
+		dev_info(dev->mt76.dev,
+			 "MCU_EXT_EVENT_CSI_REPORT: skb_len=%u, payload_len=%zu\n",
+			 skb->len, payload_len);
+		print_hex_dump(KERN_INFO, "CSI MCU payload: ", DUMP_PREFIX_OFFSET,
+			       16, 1, payload, min_t(size_t, payload_len, 64), false);
+	}
+
+	spin_lock_irqsave(&csi_buf->lock, flags);
+	csi_rec = mt76_csi_buf_write_begin(csi_buf);
+	if (csi_rec) {
+		u32 seq = csi_rec->seq_num;
+		/* Zero-initialize metadata and IQ buffers to avoid leaking uninitialized ring buffer data */
+		memset(csi_rec, 0, sizeof(*csi_rec));
+		csi_rec->seq_num = seq;
+
+		csi_rec->timestamp_us = ktime_to_us(ktime_get());
+		if (dev->mt76.phy.chandef.chan)
+			csi_rec->channel = dev->mt76.phy.chandef.chan->hw_value;
+		else
+			csi_rec->channel = dev->phy.chfreq;
+		csi_rec->band = (csi_rec->channel > 14) ? 1 : 0;
+		csi_rec->n_rx = MT76_CSI_MAX_ANTENNAS;
+		csi_rec->n_tx = 1;
+		csi_rec->n_subcarriers = MT76_CSI_MAX_SUBCARRIERS;
+
+		/* Unpack CFR matrix from raw I/Q bytes */
+		if (payload_len >= 1024) {
+			/* Interleaved 16-bit CFR: 4 antennas x 64 subcarriers x (I, Q) */
+			__le16 *raw_samples = (__le16 *)payload;
+			for (ant = 0; ant < MT76_CSI_MAX_ANTENNAS; ant++) {
+				for (sc = 0; sc < MT76_CSI_MAX_SUBCARRIERS; sc++) {
+					int idx = (ant * MT76_CSI_MAX_SUBCARRIERS + sc) * 2;
+					csi_rec->i_data[ant][sc] = (s16)le16_to_cpu(raw_samples[idx]);
+					csi_rec->q_data[ant][sc] = (s16)le16_to_cpu(raw_samples[idx + 1]);
+				}
+			}
+		} else if (payload_len >= 512) {
+			/* Interleaved 8-bit CFR: 4 antennas x 64 subcarriers x (I, Q) */
+			s8 *raw_s8 = (s8 *)payload;
+			for (ant = 0; ant < MT76_CSI_MAX_ANTENNAS; ant++) {
+				for (sc = 0; sc < MT76_CSI_MAX_SUBCARRIERS; sc++) {
+					int idx = (ant * MT76_CSI_MAX_SUBCARRIERS + sc) * 2;
+					if (idx + 1 < payload_len) {
+						csi_rec->i_data[ant][sc] = (s16)raw_s8[idx] << 4;
+						csi_rec->q_data[ant][sc] = (s16)raw_s8[idx + 1] << 4;
+					}
+				}
+			}
+		} else {
+			size_t copy_len = min_t(size_t, payload_len, sizeof(csi_rec->i_data));
+			memcpy(csi_rec->i_data, payload, copy_len);
+		}
+
+		mt76_csi_buf_write_end(csi_buf);
+	}
+	spin_unlock_irqrestore(&csi_buf->lock, flags);
+}
